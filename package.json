{
  "name": "kiber-vengance",
  "version": "6.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/core.test.js tests/ai.test.js tests/presets.test.js tests/refactor.test.js",
    "test:e2e": "node --test tests/e2e.test.js tests/browser.test.js tests/ai-browser.test.js tests/mixing-browser.test.js tests/desktop-vocals-browser.test.js",
    "test:companion": "python -m unittest discover -s companion/tests -v",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint tests scripts eslint.config.js",
    "build:runtime": "vite build",
    "build": "vite build && node scripts/build.mjs",
    "check": "npm run typecheck && npm run build && npm run lint && npm test",
    "check:full": "npm run check && npm run test:e2e"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "geckodriver": "^8.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@huggingface/transformers": "4.3.1",
    "@huggingface/transformers-structured-output": "4.3.1",
    "@mlc-ai/web-llm": "0.2.86",
    "preact": "^11.0.2",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  }
}
